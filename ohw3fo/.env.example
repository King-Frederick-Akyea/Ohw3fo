# Copy this file to .env and fill in your own values. Never commit .env.
GUARD_URL=https://secureai-guard-598609297408.europe-west4.run.app
GUARD_TOKEN=sai_your_team_token_here
OPENAI_API_KEY=sk-your_openai_key_here

# Optional
# PORT=3000
# CHAT_MODEL=gpt-4.1-mini
# ANALYSIS_MODEL=gpt-4.1-mini
# FAIL_MODE=closed        # closed = block when a Guard check could not run (recommended)
# GUARD_PER_MINUTE=28     # local rate limit, kept under the Guard's 30/min
